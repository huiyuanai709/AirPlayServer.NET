<Project>
  <!-- Keep this vendored project on the repo's warning settings, and mark it
       AOT-compatible. The published host compiles it in-process. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
