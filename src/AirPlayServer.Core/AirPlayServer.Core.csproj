<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>AirPlayServer.Core</RootNamespace>
    <AssemblyName>AirPlayServer.Core</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>AirPlay receive core: IPv4 mDNS advertisement, transient pairing, in-process FairPlay, mirror receive, TapClock frame export, and mirror session notify.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(ForceWindowsHost)' == 'true'">$(DefineConstants);WINDOWS_HOST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AirPlayServer.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\deps\AirPlayFairPlay\AirPlayFairPlay.csproj" />
  </ItemGroup>
</Project>
