<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>AirPlayServer.Host</RootNamespace>
    <AssemblyName>AirPlayServer.Host</AssemblyName>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <EventSourceSupport>false</EventSourceSupport>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Native AOT host for the AirPlayServer.NET receiver.</Description>
    <!-- Embedded into the Windows PE (Explorer, taskbar, Alt-Tab).
         Native AOT win-x64 publish picks this up via ApplicationIcon.
         linux-x64 output is ELF and does not show an exe icon. -->
    <ApplicationIcon>Assets/AirPlayServer.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- EnableAvalonia=true is the UI zip (mirror window). false, the default,
       is the lean zip: Avalonia is not referenced and Display/*.cs is not
       compiled. publish.sh / publish.ps1 pass the flag explicitly.
       Avalonia 12.1 Native AOT. The mirror UI is code-only: no XAML, no compiled
       bindings, no reflection control lookup. Avalonia's own ILLink descriptors
       root Skia and HarfBuzz. BuiltInComInteropSupport is left at the SDK default;
       that switch was only required before Avalonia 12.
       The window system is chosen here, not by UsePlatformDetect, so a linux-x64
       publish does not root Win32/user32 and a win-x64 publish does not root X11.
       Avalonia.Desktop is not referenced: each RID gets only its window package.
       Inter is not embedded (no CJK, and the chip uses a system face).
       Windows UI publish forces Skia software and drops av_libglesv2.dll. -->
  <PropertyGroup>
    <EnableAvalonia Condition="'$(EnableAvalonia)' == ''">false</EnableAvalonia>
    <EnableAvalonia Condition="'$(EnableAvalonia)' == 'True' or '$(EnableAvalonia)' == '1'">true</EnableAvalonia>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableAvalonia)' == 'true'">
    <_AvaloniaOs Condition="$(RuntimeIdentifier.StartsWith('win'))">win</_AvaloniaOs>
    <_AvaloniaOs Condition="$(RuntimeIdentifier.StartsWith('osx'))">osx</_AvaloniaOs>
    <_AvaloniaOs Condition="$(RuntimeIdentifier.StartsWith('linux'))">linux</_AvaloniaOs>
    <_AvaloniaOs Condition="'$(_AvaloniaOs)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win</_AvaloniaOs>
    <_AvaloniaOs Condition="'$(_AvaloniaOs)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx</_AvaloniaOs>
    <_AvaloniaOs Condition="'$(_AvaloniaOs)' == ''">linux</_AvaloniaOs>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableAvalonia)' == 'true' and '$(_AvaloniaOs)' == 'win'">
    <DefineConstants>$(DefineConstants);AVALONIA_UI;AVALONIA_WIN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableAvalonia)' == 'true' and '$(_AvaloniaOs)' == 'osx'">
    <DefineConstants>$(DefineConstants);AVALONIA_UI;AVALONIA_OSX</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableAvalonia)' == 'true' and '$(_AvaloniaOs)' == 'linux'">
    <DefineConstants>$(DefineConstants);AVALONIA_UI;AVALONIA_LINUX</DefineConstants>
  </PropertyGroup>

  <!-- Release publish is the shipping binary. DebugType=none keeps the
       Native AOT linker from writing a .pdb (Windows) or .dbg (Linux). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <NativeDebugSymbols>false</NativeDebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AirPlayServer.Core\AirPlayServer.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableAvalonia)' != 'true'">
    <Compile Remove="Display/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableAvalonia)' == 'true'">
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableAvalonia)' == 'true' and '$(_AvaloniaOs)' == 'win'">
    <PackageReference Include="Avalonia.Win32" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableAvalonia)' == 'true' and '$(_AvaloniaOs)' == 'linux'">
    <PackageReference Include="Avalonia.X11" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableAvalonia)' == 'true' and '$(_AvaloniaOs)' == 'osx'">
    <PackageReference Include="Avalonia.Native" Version="12.1.4" />
  </ItemGroup>

  <!-- Win32 defaults to ANGLE (av_libglesv2.dll, about 5 MB). The mirror window
       blits BGRA on the CPU and sets Win32RenderingMode.Software, so that DLL
       is not loaded. Remove it from the publish set if the package still copies it. -->
  <Target Name="DropAvaloniaAngleNative" AfterTargets="ComputeFilesToPublish" Condition="'$(EnableAvalonia)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('av_libglesv2'))" />
    </ItemGroup>
  </Target>
  <Target Name="DeleteAvaloniaAngleNative" AfterTargets="Publish" Condition="'$(EnableAvalonia)' == 'true'">
    <ItemGroup>
      <_AngleNative Include="$(PublishDir)av_libglesv2.dll" />
    </ItemGroup>
    <Delete Files="@(_AngleNative)" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="AirPlayServer.Host.Tests" />
  </ItemGroup>

  <!-- Bake the publish version into a const. Assembly attribute lookup is
       reflection, and Native AOT with warnings-as-errors will not keep it. -->
  <Target Name="GenerateHostVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_HostVersionFile>$(IntermediateOutputPath)HostVersion.g.cs</_HostVersionFile>
      <_HostInfo>$([System.Text.RegularExpressions.Regex]::Replace('$(InformationalVersion)', '[;&quot;\r\n\\]', ''))</_HostInfo>
      <_HostVer>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '[;&quot;\r\n\\]', ''))</_HostVer>
      <_HostInfo Condition="'$(_HostInfo)' == ''">0.0.0</_HostInfo>
      <_HostVer Condition="'$(_HostVer)' == ''">0.0.0</_HostVer>
    </PropertyGroup>
    <ItemGroup>
      <_AirPlayHostVersionLine Remove="@(_AirPlayHostVersionLine)" />
      <_AirPlayHostVersionLine Include="// &lt;auto-generated /&gt;" />
      <_AirPlayHostVersionLine Include="namespace AirPlayServer.Host%3B" />
      <_AirPlayHostVersionLine Include="internal static class HostVersion" />
      <_AirPlayHostVersionLine Include="{" />
      <_AirPlayHostVersionLine Include="    public const string InformationalVersion = &quot;$(_HostInfo)&quot;%3B" />
      <_AirPlayHostVersionLine Include="    public const string Version = &quot;$(_HostVer)&quot;%3B" />
      <_AirPlayHostVersionLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_HostVersionFile)" Lines="@(_AirPlayHostVersionLine)" Overwrite="true" />
    <ItemGroup>
      <Compile Remove="$(_HostVersionFile)" />
      <Compile Include="$(_HostVersionFile)" />
      <FileWrites Include="$(_HostVersionFile)" />
    </ItemGroup>
  </Target>
</Project>
